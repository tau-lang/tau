extern fn sqrt(v: f64) -> f64

extern fn puts(v: str)

struct Vec2 {
    x: f64,
    y: f64
}

const ZERO: Vec2 = Vec2 { x=0, y=0 }

fn vec2(x: f64, y: f64) -> Vec2 =
    Vec2 { x=x, y=y }

fn add(l: Vec2, r: Vec2) -> Vec2 =
    vec2(l.x + r.x, l.y + r.y)

fn sub(l: Vec2, r: Vec2) -> Vec2 =
    vec2(l.x - r.x, l.y - r.y)

fn length(v: Vec2) -> f64 =
    sqrt(v.x*v.x + v.y*v.y)

fn norm(v: Vec2) -> Vec2 {
    let len = length(v)
    if (len == 0) return ZERO
    return vec2(v.x / len, v.y / len)
}

io fn main() {
    let _a: Vec2 = add(vec2(3, 4), vec2(4, -2))
    puts("Hello, World!")
}
