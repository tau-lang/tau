//! This example shows simple math with vectors.
//! To compile and run this script:
//!
//! ```sh
//! tau vec2.tau
//! gcc -o vec2 vec2.o utils.c -lm
//! ./vec2
//! ```

extern fn sqrt(v: f64) -> f64;

extern fn puts(v: str) -> i32;

extern fn print_f64(format: str, value: f64) -> i32;

struct Vec2 {
    x: f64,
    y: f64
}

fn vec2(x: f64, y: f64) -> Vec2 =
    Vec2 { x=x, y=y }

fn add(l: Vec2, r: Vec2) -> Vec2 =
    vec2(l.x + r.x, l.y + r.y)

fn sub(l: Vec2, r: Vec2) -> Vec2 =
    vec2(l.x - r.x, l.y - r.y)

fn length(v: Vec2) -> f64 =
    sqrt(v.x * v.x + v.y * v.y)

fn norm(v: Vec2) -> Vec2 =
    let len = length(v);
    in
        if (len == 0.0) { vec2(0.0, 0.0) }
        else { vec2(v.x / len, v.y / len) }

fn print(v: Vec2) {
    print_f64("Vec { x=%f, ", v.x);
    print_f64("y=%f }\n", v.y);
}

fn main() -> i32 {
    let v1 = vec2(3.0, 4.0);
    print(v1);
    let v2 = vec2(4.0, -2.0);
    print(v2);
    let v3 = add(v1, v2);
    print(v3);
    print_f64("Vector has length %f.\n", length(v3));
    
    return 0;
}
