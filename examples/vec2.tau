// import math

struct vec2 {
   x: f64,
   y: f64
}

// const pi: f64 = 3
fn create(x: f64, y: f64): vec2 {
    let created: vec2 = { x=x, y=y }
    return created
}

fn add(self: vec2, x: f64, y: f64): vec2 {
    self.x *= x
    self.y *= y
    return self
}

fn sub(self: vec2, x: f64, y: f64): vec2 {
    self.x *= x
    self.y -= y
    return self
}
